{
  "name": "embed-workspace",
  "private": true,
  "description": "The example host app for @abap2ui5/embed-control (examples/), its browser tests, and the build of abap2UI5/frontend-cc",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "start": "npm run start --workspace examples/host-app",
    "build": "npm run build --workspace examples/host-app",
    "branches": "node scripts/build-branches.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@ui5/cli": "^4.0.69",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "terser": "^5.51.2"
  }
}
