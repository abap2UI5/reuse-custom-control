<mvc:View
    controllerName="demo.host.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:z2ui5="z2ui5.embed"
    displayBlock="true"
    height="100%">
    <App id="app">
        <Page id="page" title="A plain UI5 app with abap2UI5 inside">
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                    text="The framed areas are abap2UI5 apps: view and logic come from an ABAP class on the backend. Everything around them is this UI5 app."/>

                <Title text="One app, chosen by the host" titleStyle="H4" class="sapUiSmallMarginTop"/>
                <Text
                    class="sapUiTinyMarginBottom"
                    text="The class is bound to this app's model. Change it and the control ends the running session and starts the new app."/>
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <Label text="ABAP class" labelFor="input" class="sapUiTinyMarginEnd"/>
                    <Input id="input" value="{host>/input}" width="22rem" submit=".onStart"/>
                    <Button id="start" text="Start" type="Emphasized" press=".onStart" class="sapUiTinyMarginBegin"/>
                </HBox>
                <z2ui5:Container
                    id="single"
                    app="{host>/app}"
                    height="420px"
                    class="demoHostFrame"
                    componentCreated=".onComponentCreated"
                    componentFailed=".onComponentFailed"/>

                <Title text="Two instances, two sessions" titleStyle="H4" class="sapUiMediumMarginTop"/>
                <Text
                    class="sapUiTinyMarginBottom"
                    text="Each control runs its own abap2UI5 session - type a name on one side and post it, the other side keeps its own state."/>
                <l:Grid defaultSpan="XL6 L6 M12 S12" hSpacing="1" vSpacing="0">
                    <z2ui5:Container id="left" app="Z2UI5_CL_UI5_APP_HI_WORLD" height="360px" class="demoHostFrame"/>
                    <z2ui5:Container id="right" app="Z2UI5_CL_UI5_APP_HI_WORLD" height="360px" class="demoHostFrame"/>
                </l:Grid>
            </VBox>
        </Page>
    </App>
</mvc:View>
