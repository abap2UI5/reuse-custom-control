# Copy to .env to run the example against a real SAP system instead of the
# local Node backend. The proxy forwards /sap/** to this base URI.
UI5_MIDDLEWARE_SIMPLE_PROXY_BASEURI=https://my-sap-system:44300/sap
# UI5_MIDDLEWARE_SIMPLE_PROXY_USERNAME=me
# UI5_MIDDLEWARE_SIMPLE_PROXY_PASSWORD=secret
# UI5_MIDDLEWARE_SIMPLE_PROXY_QUERY={"sap-client":"100"}
# for a system with a self-signed certificate:
# UI5_MIDDLEWARE_SIMPLE_PROXY_STRICT_SSL=false
